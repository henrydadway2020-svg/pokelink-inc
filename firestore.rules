rules_version = '2';

// Reglas de Firestore para PokeLink/TCGmini.
// Pega esto en: Firebase Console → Firestore Database → Reglas → Publicar.
//
// Punto de partida razonable (cualquier usuario autenticado, incluido
// anónimo, puede leer/escribir salas y partidas — es lo mínimo para que
// dos desconocidos puedan encontrarse por código). Se puede endurecer más
// adelante validando forma de los datos con `request.resource.data`.

service cloud.firestore {
  match /databases/{database}/documents {

    // Salas de Draft 1v1 (js/draft-multi.js)
    match /rooms/{code} {
      allow read, write: if request.auth != null;
    }

    // Partidas PvP del tablero (js/pvp.js, js/pvp-sync.js)
    match /pvpGames/{code} {
      allow read, write: if request.auth != null;

      // Datos privados por jugador (mano oculta, etc.) — solo el dueño
      // del uid puede leer o escribir su propio documento privado.
      match /priv/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Presencia (contador de "en línea" / "en partida") — js/presence.js
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
